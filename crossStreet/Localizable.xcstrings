        }
      }
    },
    "Allow Intersector to use your location in iPhone Settings, then choose Nearest or Upcoming to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Intersector to use your location in iPhone Settings, then choose Nearest or Upcoming to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Intersector use tu ubicación en Configuración del iPhone y elige Más cercana o Más adelante para volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Intersector use sua localização nos Ajustes do iPhone e escolha Mais próximo ou À frente para tentar novamente."
