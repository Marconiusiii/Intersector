    "Distance adds the approximate distance to an intersection. Use Measurement Unit to choose feet or meters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance adds the approximate distance to an intersection. Use Measurement Unit to choose feet or meters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distancia añade la distancia aproximada a una intersección. Usa Unidad de medida para elegir pies o metros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância adiciona a distância aproximada até um cruzamento. Use Unidade de medida para escolher pés ou metros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance ajoute la distance approximative d’une intersection. Utilisez Unité de mesure pour choisir les pieds ou les mètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
