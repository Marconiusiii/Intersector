    "Use the menus beside Nearest and Upcoming to choose the second or third result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the menus beside Nearest and Upcoming to choose the second or third result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los menús junto a Más cercana y Más adelante para elegir el segundo o tercer resultado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os menus ao lado de Mais próximo e À frente para escolher o segundo ou o terceiro resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les menus à côté de Plus proche et À venir pour choisir le deuxième ou le troisième résultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in den Menüs neben Nächste und Voraus das zweite oder dritte Ergebnis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i menu accanto a Più vicino e In arrivo per scegliere il secondo o terzo risultato."
          }
        }
      }
    },
    "Use the Shortcuts app to create your own phrases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Shortcuts app to create your own phrases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la app Atajos para crear tus propias frases."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o app Atalhos para criar suas próprias frases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’app Raccourcis pour créer vos propres phrases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eigene Sätze in der App Kurzbefehle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l’app Comandi Rapidi per creare le tue frasi."
          }
        }
      }
    },
    "Use Upcoming to find the next intersection along your current road in the direction your phone is facing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Upcoming to find the next intersection along your current road in the direction your phone is facing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Más adelante para encontrar la siguiente intersección en la vía actual, en la dirección hacia la que apunta el teléfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use À frente para encontrar o próximo cruzamento na via atual, na direção para a qual o celular está apontando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez À venir pour trouver la prochaine intersection sur votre voie actuelle, dans la direction vers laquelle votre téléphone pointe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Voraus, um die nächste Kreuzung entlang Ihrer aktuellen Straße in der Ausrichtung Ihres Telefons zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa In arrivo per trovare il prossimo incrocio lungo la strada attuale nella direzione verso cui punta il telefono."
          }
        }
      }
    },
    "Use Uptown, Downtown, East Side, and West Side for spoken compass directions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Uptown, Downtown, East Side, and West Side for spoken compass directions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Uptown, Downtown, East Side y West Side para las direcciones cardinales anunciadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Uptown, Downtown, East Side e West Side para as direções cardeais anunciadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser Uptown, Downtown, East Side et West Side pour les points cardinaux annoncés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uptown, Downtown, East Side und West Side für gesprochene Himmelsrichtungen verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Uptown, Downtown, East Side e West Side per i punti cardinali pronunciati."
          }
        }
      }
    },
    "Vibration gets stronger as you point toward a result. Use Haptic scan feedback in Settings to turn vibration on or off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibration gets stronger as you point toward a result. Use Haptic scan feedback in Settings to turn vibration on or off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vibración aumenta al apuntar hacia un resultado. Usa Vibración al explorar en Configuración para activar o desactivar la vibración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vibração fica mais forte quando você aponta para um resultado. Use Vibração ao explorar nas Configurações para ativar ou desativar a vibração."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vibrations s’intensifient lorsque vous pointez vers un résultat. Utilisez Vibrations du balayage dans les réglages pour activer ou désactiver les vibrations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vibration wird stärker, wenn Sie auf ein Ergebnis zeigen. Mit Haptisches Scan-Feedback in den Einstellungen schalten Sie die Vibration ein oder aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vibrazione aumenta quando punti verso un risultato. Usa Feedback aptico dell’esplorazione nelle impostazioni per attivare o disattivare la vibrazione."
          }
        }
      }
    },
