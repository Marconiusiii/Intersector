    "Waiting for map data. Nearest and Upcoming will become available automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for map data. Nearest and Upcoming will become available automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando los datos del mapa. Más cercana y Más adelante estarán disponibles automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando os dados do mapa. Mais próximo e À frente ficarão disponíveis automaticamente."
          }
        },
        "fr": {
