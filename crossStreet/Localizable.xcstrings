    "Map services are temporarily busy. Please wait a minute before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map services are temporarily busy. Please wait a minute before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de mapas están ocupados temporalmente. Espera un minuto e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços de mapas estão temporariamente ocupados. Aguarde um minuto e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services cartographiques sont temporairement occupés. Attendez une minute avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartendienste sind vorübergehend ausgelastet. Warten Sie eine Minute und versuchen Sie es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi delle mappe sono temporaneamente occupati. Attendi un minuto prima di riprovare."
          }
        }
      }
    },
    "Map services are temporarily busy. Please wait a minute, then choose Nearest or Upcoming to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map services are temporarily busy. Please wait a minute, then choose Nearest or Upcoming to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de mapas están ocupados temporalmente. Espera un minuto y elige Más cercana o Más adelante para volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços de mapas estão temporariamente ocupados. Aguarde um minuto e escolha Mais próximo ou À frente para tentar novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services cartographiques sont temporairement occupés. Attendez une minute, puis choisissez Plus proche ou À venir pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartendienste sind vorübergehend ausgelastet. Warten Sie eine Minute und wählen Sie dann Nächste oder Voraus, um es erneut zu versuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi delle mappe sono temporaneamente occupati. Attendi un minuto, poi scegli Più vicino o In arrivo per riprovare."
          }
        }
      }
    },
