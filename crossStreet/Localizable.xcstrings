    "Direction adds the direction of an intersection. Choose Relative for ahead, left, and right; Cardinal for north, south, east, and west; or Clock Face for positions such as 10 o’clock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction adds the direction of an intersection. Choose Relative for ahead, left, and right; Cardinal for north, south, east, and west; or Clock Face for positions such as 10 o’clock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección añade la dirección de una intersección. Elige Relativa para adelante, izquierda y derecha; Cardinal para norte, sur, este y oeste; o Reloj para posiciones como las 10."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direção adiciona a direção de um cruzamento. Escolha Relativa para à frente, esquerda e direita; Cardeal para norte, sul, leste e oeste; ou Relógio para posições como 10 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction ajoute la direction d’une intersection. Choisissez Relative pour devant, gauche et droite, Points cardinaux pour nord, sud, est et ouest, ou Cadran d’horloge pour des positions comme 10 heures."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtung ergänzt die Richtung einer Kreuzung. Wählen Sie Relativ für voraus, links und rechts, Himmelsrichtung für Norden, Süden, Osten und Westen oder Zifferblatt für Positionen wie 10 Uhr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Direzione aggiunge la direzione di un incrocio. Scegli Relativa per davanti, sinistra e destra, Punti cardinali per nord, sud, est e ovest, oppure Quadrante per posizioni come ore 10."
          }
        }
      }
    },
    "Direction is not available yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction is not available yet."
          }
        },
        "es": {
