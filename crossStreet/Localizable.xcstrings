    "Intersector helps you identify nearby intersections and orient yourself by street direction. It is built for quick, accessible street context from the app or Siri.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector helps you identify nearby intersections and orient yourself by street direction. It is built for quick, accessible street context from the app or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector te ayuda a identificar intersecciones cercanas y orientarte según la dirección de las calles. Ofrece información rápida y accesible sobre las calles desde la app o Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Intersector ajuda a identificar cruzamentos próximos e a se orientar pela direção das ruas. Ele oferece informações rápidas e acessíveis sobre as ruas pelo app ou pela Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector vous aide à identifier les intersections à proximité et à vous orienter selon la direction des rues. Il fournit rapidement des informations accessibles sur les rues depuis l’app ou Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector hilft Ihnen, Kreuzungen in der Nähe zu erkennen und sich anhand der Straßenrichtung zu orientieren. Die App bietet schnelle, barrierefreie Straßeninformationen direkt in der App oder über Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector ti aiuta a identificare gli incroci nelle vicinanze e a orientarti in base alla direzione delle strade. Offre informazioni rapide e accessibili sulle strade tramite l’app o Siri."
          }
        }
      }
    },
    "Intersector helps you identify nearby intersections, find the direction your phone is facing, and get street information through the app, Siri, Shortcuts, or Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector helps you identify nearby intersections, find the direction your phone is facing, and get street information through the app, Siri, Shortcuts, or Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector te ayuda a identificar intersecciones cercanas, saber hacia dónde apunta el teléfono y obtener información sobre las calles mediante la app, Siri, Atajos o Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Intersector ajuda a identificar cruzamentos próximos, descobrir a direção para a qual o celular está apontando e obter informações sobre as ruas pelo app, pela Siri, pelo Atalhos ou pelo Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector vous aide à identifier les intersections à proximité, à connaître la direction vers laquelle votre téléphone pointe et à obtenir des informations sur les rues depuis l’app, Siri, Raccourcis ou l’Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector hilft Ihnen, Kreuzungen in der Nähe zu erkennen, die Ausrichtung Ihres Telefons zu bestimmen und Straßeninformationen über die App, Siri, Kurzbefehle oder die Apple Watch abzurufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector ti aiuta a identificare gli incroci nelle vicinanze, a conoscere la direzione verso cui punta il telefono e a ottenere informazioni sulle strade tramite l’app, Siri, Comandi Rapidi o Apple Watch."
          }
        }
      }
    },
