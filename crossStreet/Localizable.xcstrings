    "Use Direction to hear the direction your phone is facing, such as north or southwest.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Direction to hear the direction your phone is facing, such as north or southwest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Mi dirección para escuchar hacia dónde apunta el teléfono, como norte o suroeste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Minha direção para ouvir a direção para a qual o celular está apontando, como norte ou sudoeste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Direction pour entendre la direction vers laquelle votre téléphone pointe, comme nord ou sud-ouest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Richtung, um die Ausrichtung Ihres Telefons zu hören, etwa Norden oder Südwesten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Direzione per ascoltare la direzione verso cui punta il telefono, ad esempio nord o sud-ovest."
          }
        }
      }
    },
    "Use Intersector on your watch for Nearest, Upcoming, Direction, and second and third results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Intersector on your watch for Nearest, Upcoming, Direction, and second and third results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Intersector en el reloj para Más cercana, Más adelante, Mi dirección y los resultados segundo y tercero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Intersector no relógio para Mais próximo, À frente, Minha direção e os resultados segundo e terceiro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Intersector sur votre montre pour Plus proche, À venir, Direction et les deuxième et troisième résultats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Intersector auf Ihrer Watch für Nächste, Voraus, Richtung sowie zweite und dritte Ergebnisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Intersector sull’orologio per Più vicino, In arrivo, Direzione e per il secondo e terzo risultato."
          }
        }
      }
    },
    "Use Nearest to find the intersection closest to your current location.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Nearest to find the intersection closest to your current location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Más cercana para encontrar la intersección más próxima a tu ubicación actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Mais próximo para encontrar o cruzamento mais perto da sua localização atual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Plus proche pour trouver l’intersection la plus proche de votre position actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Nächste, um die Kreuzung mit der geringsten Entfernung zu Ihrem Standort zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Più vicino per trovare l’incrocio più vicino alla tua posizione attuale."
          }
        }
      }
    },
    "Use Show 2nd and 3rd Controls in Settings to show or hide these menus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Show 2nd and 3rd Controls in Settings to show or hide these menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Mostrar controles del segundo y tercer resultado en Configuración para mostrar u ocultar estos menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Mostrar controles do segundo e terceiro resultados nas Configurações para mostrar ou ocultar esses menus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Afficher les commandes 2 et 3 dans les réglages pour afficher ou masquer ces menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Zweite und dritte Auswahl anzeigen in den Einstellungen blenden Sie diese Menüs ein oder aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Mostra i controlli per il secondo e terzo risultato nelle impostazioni per mostrare o nascondere questi menu."
          }
        }
      }
    },
    "Use Siri or Shortcuts for Nearest Intersection, Upcoming Intersection, My Direction, Scan Mode, Start Live Mode, and Stop Live Mode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Siri or Shortcuts for Nearest Intersection, Upcoming Intersection, My Direction, Scan Mode, Start Live Mode, and Stop Live Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Siri o Atajos para Intersección más cercana, Intersección más adelante, Mi dirección, modo Explorar, Iniciar modo de seguimiento y Detener el modo de seguimiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Siri ou o Atalhos para Cruzamento mais próximo, Cruzamento à frente, Minha direção, modo Explorar, Iniciar acompanhamento e Parar acompanhamento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Siri ou Raccourcis pour Intersection la plus proche, Intersection à venir, Ma direction, Mode balayage, Démarrer le mode en direct et Arrêter le mode en direct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Siri oder Kurzbefehle für Nächstgelegene Kreuzung, Kreuzung voraus, Meine Richtung, Scan-Modus, Live-Modus starten und Live-Modus stoppen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Siri o Comandi Rapidi per Incrocio più vicino, Incrocio in arrivo, La mia direzione, Modalità esplorazione, Avvia modalità Live e Interrompi modalità Live."
          }
        }
      }
    },
    "Use Siri Shortcuts": {
      "extractionState": "manual",
      "localizations": {
