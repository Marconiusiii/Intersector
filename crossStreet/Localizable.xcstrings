          "stringUnit": {
            "state": "translated",
            "value": "Intersector tiene problemas para cargar los datos del mapa. Elige Más cercana o Más adelante para volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Intersector está com dificuldade para carregar os dados do mapa. Escolha Mais próximo ou À frente para tentar novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector rencontre des difficultés pour charger la carte. Choisissez Plus proche ou À venir pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector hat Schwierigkeiten, Kartendaten zu laden. Wählen Sie Nächste oder Voraus, um es erneut zu versuchen."
          }
        },
        "it": {
