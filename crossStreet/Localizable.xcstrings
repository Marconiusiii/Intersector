    "Try saying: Nearest intersection in Intersector. Upcoming intersection in Intersector. Start Scan Mode in Intersector. You can also set up your own shortcuts using Intersector in the Shortcuts app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try saying: Nearest intersection in Intersector. Upcoming intersection in Intersector. Start Scan Mode in Intersector. You can also set up your own shortcuts using Intersector in the Shortcuts app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a decir: Intersección más cercana en Intersector. Intersección más adelante en Intersector. Iniciar modo Explorar en Intersector. También puedes crear tus propios atajos con Intersector en la app Atajos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente dizer: Cruzamento mais próximo no Intersector. Cruzamento à frente no Intersector. Iniciar modo Explorar no Intersector. Você também pode criar seus próprios atalhos com o Intersector no app Atalhos."
          }
        }
      }
    },
    "Turn Scan off before moving to a new location. Once you arrive, turn it on again to scan from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Scan off before moving to a new location. Once you arrive, turn it on again to scan from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Explorar antes de desplazarte a otro lugar. Cuando llegues, actívalo de nuevo para explorar desde allí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative Explorar antes de ir para outro local. Ao chegar, ative-o novamente para explorar a partir dali."
          }
        }
      }
    },
    "Turn on Live Mode in Settings before starting Live Mode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Mode in Settings before starting Live Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el modo de seguimiento en Configuración antes de iniciarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o modo de acompanhamento nas Configurações antes de iniciá-lo."
          }
        }
      }
    },
    "Turn on Live to hear upcoming intersections as you travel, including while the phone is locked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live to hear upcoming intersections as you travel, including while the phone is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Seguimiento para escuchar las intersecciones más adelante mientras te desplazas, incluso con el teléfono bloqueado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Acompanhamento para ouvir os cruzamentos à frente enquanto se desloca, inclusive com o celular bloqueado."
          }
        }
      }
    },
    "Turn on Scan and point the top of your phone around you to identify nearby intersections and crossings. Intersector announces a result when your phone lines up with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Scan and point the top of your phone around you to identify nearby intersections and crossings. Intersector announces a result when your phone lines up with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Explorar y apunta la parte superior del teléfono a tu alrededor para identificar intersecciones y cruces peatonales cercanos. Intersector anuncia un resultado cuando el teléfono apunta hacia él."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Explorar e aponte a parte superior do celular ao seu redor para identificar cruzamentos e travessias próximos. O Intersector anuncia um resultado quando o celular está alinhado com ele."
          }
        }
      }
    },
