    },
    "Tall buildings, magnetic interference, and missing or outdated map information can affect the announcements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tall buildings, magnetic interference, and missing or outdated map information can affect the announcements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los edificios altos, las interferencias magnéticas y la información del mapa ausente o desactualizada pueden afectar a los anuncios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prédios altos, interferências magnéticas e informações ausentes ou desatualizadas no mapa podem afetar os anúncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les grands bâtiments, les interférences magnétiques et les informations cartographiques manquantes ou obsolètes peuvent affecter les annonces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Gebäude, magnetische Störungen sowie fehlende oder veraltete Karteninformationen können die Ansagen beeinflussen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli edifici alti, le interferenze magnetiche e le informazioni della mappa mancanti o obsolete possono influire sugli annunci."
          }
        }
      }
    },
