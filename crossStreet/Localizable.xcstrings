    "%@ Live Mode off. Turn Live back on after exiting the highway.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Live Mode off. Turn Live back on after exiting the highway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Seguimiento desactivado. Vuelve a activarlo al salir de la autopista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Acompanhamento desativado. Ative-o novamente depois de sair da rodovia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mode en direct désactivé. Réactivez-le après avoir quitté l’autoroute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Live-Modus ausgeschaltet. Schalten Sie Live nach dem Verlassen der Autobahn wieder ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Modalità Live disattivata. Riattivala dopo aver lasciato l’autostrada."
          }
        }
      }
    },
