    "Change announcement settings on your iPhone to use them on your watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change announcement settings on your iPhone to use them on your watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia los ajustes de los anuncios en el iPhone para usarlos en el reloj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere os ajustes dos anúncios no iPhone para usá-los no relógio."
          }
        }
      }
    },
    "Choose Default to place the heading beside the announcement, or Centered to place it above the announcement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Default to place the heading beside the announcement, or Centered to place it above the announcement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Predeterminada para colocar el encabezado junto al anuncio, o Centrada para colocarlo encima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Padrão para colocar o título ao lado do anúncio, ou Centralizado para colocá-lo acima do anúncio."
          }
        }
      }
    },
    "Choose Walking for travel on foot or Driving for travel by car or bus. Driving announces intersections sooner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Walking for travel on foot or Driving for travel by car or bus. Driving announces intersections sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige A pie para caminar o En vehículo para viajar en coche o autobús. En vehículo anuncia las intersecciones con más anticipación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha A pé para caminhar ou De carro para viajar de carro ou ônibus. De carro anuncia os cruzamentos com mais antecedência."
          }
        }
      }
    },
    "Choose a voice, Speech Rate, and Speech Volume for Live announcements. Use Test Speech to hear your selections.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a voice, Speech Rate, and Speech Volume for Live announcements. Use Test Speech to hear your selections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una voz, Velocidad de voz y Volumen de voz para los anuncios de Seguimiento. Usa Probar voz para escuchar tus selecciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma voz, Velocidade da fala e Volume da fala para os anúncios de Acompanhamento. Use Testar voz para ouvir suas escolhas."
          }
        }
      }
    },
