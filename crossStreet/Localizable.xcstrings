    "Intersector needs your location to find the streets and intersections around you. The next step opens the iOS location permission request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector needs your location to find the streets and intersections around you. The next step opens the iOS location permission request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector necesita tu ubicación para encontrar las calles e intersecciones a tu alrededor. El siguiente paso abre la solicitud de permiso de ubicación de iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Intersector precisa da sua localização para encontrar as ruas e os cruzamentos ao seu redor. A próxima etapa abre a solicitação de permissão de localização do iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector a besoin de votre position pour trouver les rues et les intersections autour de vous. L’étape suivante ouvre la demande d’autorisation de localisation d’iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector benötigt Ihren Standort, um Straßen und Kreuzungen in Ihrer Umgebung zu finden. Im nächsten Schritt öffnet sich die iOS-Anfrage für den Standortzugriff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intersector ha bisogno della tua posizione per trovare le strade e gli incroci intorno a te. Il passaggio successivo apre la richiesta di autorizzazione alla posizione di iOS."
          }
        }
      }
    },
