    "Apple Watch support is included. If Intersector does not appear on your watch automatically, open the Watch app on iPhone and install it from Available Apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch support is included. If Intersector does not appear on your watch automatically, open the Watch app on iPhone and install it from Available Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se incluye compatibilidad con Apple Watch. Si Intersector no aparece automáticamente en el reloj, abre la app Watch en el iPhone e instálalo desde Apps disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O suporte ao Apple Watch está incluído. Se o Intersector não aparecer automaticamente no relógio, abra o app Watch no iPhone e instale-o em Apps Disponíveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prise en charge de l’Apple Watch est incluse. Si Intersector n’apparaît pas automatiquement sur votre montre, ouvrez l’app Watch sur l’iPhone et installez-le depuis Apps disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Watch wird unterstützt. Wenn Intersector nicht automatisch auf Ihrer Watch erscheint, öffnen Sie die Watch-App auf dem iPhone und installieren Sie Intersector unter Verfügbare Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il supporto per Apple Watch è incluso. Se Intersector non appare automaticamente sull’orologio, apri l’app Watch su iPhone e installalo da App disponibili."
          }
        }
      }
    },
