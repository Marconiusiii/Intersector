    "Try saying: Nearest intersection in Intersector. Upcoming intersection in Intersector. Start Scan Mode in Intersector. You can also set up your own shortcuts using Intersector in the Shortcuts app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try saying: Nearest intersection in Intersector. Upcoming intersection in Intersector. Start Scan Mode in Intersector. You can also set up your own shortcuts using Intersector in the Shortcuts app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a decir: Intersección más cercana en Intersector. Intersección más adelante en Intersector. Iniciar modo Explorar en Intersector. También puedes crear tus propios atajos con Intersector en la app Atajos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente dizer: Cruzamento mais próximo no Intersector. Cruzamento à frente no Intersector. Iniciar modo Explorar no Intersector. Você também pode criar seus próprios atalhos com o Intersector no app Atalhos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de dire : Intersection la plus proche dans Intersector. Intersection à venir dans Intersector. Démarrer le mode balayage dans Intersector. Vous pouvez aussi créer vos propres raccourcis avec Intersector dans l’app Raccourcis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie zum Beispiel: Nächstgelegene Kreuzung in Intersector. Kreuzung voraus in Intersector. Scan-Modus starten in Intersector. In der App Kurzbefehle können Sie auch eigene Kurzbefehle mit Intersector erstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a dire: Incrocio più vicino in Intersector. Incrocio in arrivo in Intersector. Avvia modalità esplorazione in Intersector. Puoi anche creare i tuoi comandi rapidi con Intersector nell’app Comandi Rapidi."
          }
        }
      }
    },
    "Turn on Live Mode in Settings before starting Live Mode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Mode in Settings before starting Live Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el modo de seguimiento en Configuración antes de iniciarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o modo de acompanhamento nas Configurações antes de iniciá-lo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Mode en direct dans les réglages avant de le démarrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Live-Modus in den Einstellungen ein, bevor Sie ihn starten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Modalità Live nelle impostazioni prima di avviarla."
          }
        }
      }
    },
    "Turn on Live to hear upcoming intersections as you travel, including while the phone is locked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live to hear upcoming intersections as you travel, including while the phone is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Seguimiento para escuchar las intersecciones más adelante mientras te desplazas, incluso con el teléfono bloqueado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Acompanhamento para ouvir os cruzamentos à frente enquanto se desloca, inclusive com o celular bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez En direct pour entendre les intersections à venir pendant vos déplacements, même lorsque le téléphone est verrouillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Live ein, um unterwegs Kreuzungen voraus zu hören, auch bei gesperrtem Telefon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Live per ascoltare gli incroci in arrivo mentre ti sposti, anche quando il telefono è bloccato."
          }
        }
      }
    },
    "Turn on Scan and point the top of your phone around you to identify nearby intersections and crossings. Intersector announces a result when your phone lines up with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Scan and point the top of your phone around you to identify nearby intersections and crossings. Intersector announces a result when your phone lines up with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Explorar y apunta la parte superior del teléfono a tu alrededor para identificar intersecciones y cruces peatonales cercanos. Intersector anuncia un resultado cuando el teléfono apunta hacia él."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Explorar e aponte a parte superior do celular ao seu redor para identificar cruzamentos e travessias próximos. O Intersector anuncia um resultado quando o celular está alinhado com ele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Balayer et pointez le haut de votre téléphone autour de vous pour identifier les intersections et les passages à proximité. Intersector annonce un résultat lorsque votre téléphone pointe vers lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Scannen ein und richten Sie die Oberkante Ihres Telefons in verschiedene Richtungen, um Kreuzungen und Übergänge in der Nähe zu finden. Intersector sagt ein Ergebnis an, sobald Ihr Telefon darauf zeigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Esplora e punta la parte superiore del telefono intorno a te per identificare incroci e attraversamenti nelle vicinanze. Intersector annuncia un risultato quando il telefono punta nella sua direzione."
          }
        }
      }
    },
    "Turn Scan off before moving to a new location. Once you arrive, turn it on again to scan from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Scan off before moving to a new location. Once you arrive, turn it on again to scan from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Explorar antes de desplazarte a otro lugar. Cuando llegues, actívalo de nuevo para explorar desde allí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative Explorar antes de ir para outro local. Ao chegar, ative-o novamente para explorar a partir dali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez le balayage avant de vous déplacer. Une fois arrivé, réactivez-le pour balayer depuis votre nouvel emplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Scannen aus, bevor Sie sich an einen neuen Ort begeben. Schalten Sie es dort wieder ein, um von diesem Standort aus zu scannen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l’esplorazione prima di spostarti. Una volta arrivato, riattivala per esplorare dalla nuova posizione."
          }
        }
      }
    },
    "Unable to start Scan Mode. %@": {
      "extractionState": "manual",
