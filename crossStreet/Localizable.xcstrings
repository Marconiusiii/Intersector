    "Choose Default to place the heading beside the announcement, or Centered to place it above the announcement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Default to place the heading beside the announcement, or Centered to place it above the announcement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Predeterminada para colocar el encabezado junto al anuncio, o Centrada para colocarlo encima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Padrão para colocar o título ao lado do anúncio, ou Centralizado para colocá-lo acima do anúncio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Par défaut pour placer le titre à côté de l’annonce, ou Centré pour le placer au-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Standard, um die Überschrift neben der Ansage anzuzeigen, oder Zentriert, um sie darüber anzuzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Predefinita per posizionare il titolo accanto all’annuncio, oppure Centrato per posizionarlo sopra."
          }
        }
      }
    },
    "Choose Walking for travel on foot or Driving for travel by car or bus. Driving announces intersections sooner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Walking for travel on foot or Driving for travel by car or bus. Driving announces intersections sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige A pie para caminar o En vehículo para viajar en coche o autobús. En vehículo anuncia las intersecciones con más anticipación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha A pé para caminhar ou De carro para viajar de carro ou ônibus. De carro anuncia os cruzamentos com mais antecedência."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez À pied pour marcher ou En voiture pour les trajets en voiture ou en bus. En voiture annonce les intersections plus tôt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Zu Fuß für Fußwege oder Fahren für Fahrten mit dem Auto oder Bus. Fahren kündigt Kreuzungen früher an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli A piedi per camminare o In auto per viaggiare in auto o in autobus. In auto annuncia gli incroci in anticipo."
          }
        }
      }
    },
