    "Change announcement settings on your iPhone to use them on your watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change announcement settings on your iPhone to use them on your watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia los ajustes de los anuncios en el iPhone para usarlos en el reloj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere os ajustes dos anúncios no iPhone para usá-los no relógio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez les réglages des annonces sur votre iPhone pour les utiliser sur votre montre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie die Ansageeinstellungen auf Ihrem iPhone, um sie auf Ihrer Watch zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica le impostazioni degli annunci su iPhone per usarle sull’orologio."
          }
        }
      }
    },
    "Choose a voice, Speech Rate, and Speech Volume for Live announcements. Use Test Speech to hear your selections.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a voice, Speech Rate, and Speech Volume for Live announcements. Use Test Speech to hear your selections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una voz, Velocidad de voz y Volumen de voz para los anuncios de Seguimiento. Usa Probar voz para escuchar tus selecciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma voz, Velocidade da fala e Volume da fala para os anúncios de Acompanhamento. Use Testar voz para ouvir suas escolhas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une voix, un débit et un volume pour les annonces en direct. Utilisez Tester la voix pour écouter vos choix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Stimme, Sprechtempo und Sprachlautstärke für Live-Ansagen. Mit Sprache testen hören Sie Ihre Auswahl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una voce, una velocità e un volume per gli annunci Live. Usa Prova voce per ascoltare le tue scelte."
          }
        }
      }
    },
