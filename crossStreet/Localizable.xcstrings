    "The map server returned error 429, which usually means too many requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map server returned error 429, which usually means too many requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de mapas devolvió el error 429, que suele indicar demasiadas solicitudes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de mapas retornou o erro 429, que geralmente indica solicitações em excesso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur cartographique a renvoyé l’erreur 429, ce qui indique généralement un trop grand nombre de demandes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kartenserver hat Fehler 429 gemeldet. Dies bedeutet meist, dass zu viele Anfragen vorliegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server delle mappe ha restituito l’errore 429, che di solito indica troppe richieste."
          }
        }
      }
    },
    "The map server returned error 504, which usually means the request timed out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map server returned error 504, which usually means the request timed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de mapas devolvió el error 504, que suele indicar que se agotó el tiempo de espera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de mapas retornou o erro 504, que geralmente indica que o tempo de espera acabou."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur cartographique a renvoyé l’erreur 504, ce qui indique généralement un délai d’attente dépassé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kartenserver hat Fehler 504 gemeldet. Dies bedeutet meist, dass die Anfrage zu lange gedauert hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server delle mappe ha restituito l’errore 504, che di solito indica che la richiesta ha impiegato troppo tempo."
          }
        }
      }
    },
