    "Direction adds the direction of an intersection. Choose Relative for ahead, left, and right; Cardinal for north, south, east, and west; or Clock Face for positions such as 10 o’clock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction adds the direction of an intersection. Choose Relative for ahead, left, and right; Cardinal for north, south, east, and west; or Clock Face for positions such as 10 o’clock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección añade la dirección de una intersección. Elige Relativa para adelante, izquierda y derecha; Cardinal para norte, sur, este y oeste; o Reloj para posiciones como las 10."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direção adiciona a direção de um cruzamento. Escolha Relativa para à frente, esquerda e direita; Cardeal para norte, sul, leste e oeste; ou Relógio para posições como 10 horas."
          }
        }
      }
    },
