    "Allow Intersector to use your location in iPhone Settings, then ask again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Intersector to use your location in iPhone Settings, then ask again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Intersector use tu ubicación en Configuración del iPhone y vuelve a preguntar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Intersector use sua localização nos Ajustes do iPhone e pergunte novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Intersector à accéder à votre position dans les réglages de l’iPhone, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Intersector in den iPhone-Einstellungen den Standortzugriff und fragen Sie erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Intersector di usare la tua posizione nelle impostazioni di iPhone, poi riprova."
          }
        }
      }
    },
    "Allow Intersector to use your location in iPhone Settings, then choose Nearest or Upcoming to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Intersector to use your location in iPhone Settings, then choose Nearest or Upcoming to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Intersector use tu ubicación en Configuración del iPhone y elige Más cercana o Más adelante para volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Intersector use sua localização nos Ajustes do iPhone e escolha Mais próximo ou À frente para tentar novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Intersector à accéder à votre position dans les réglages de l’iPhone, puis choisissez Plus proche ou À venir pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Intersector in den iPhone-Einstellungen den Standortzugriff. Wählen Sie dann Nächste oder Voraus, um es erneut zu versuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Intersector di usare la tua posizione nelle impostazioni di iPhone, poi scegli Più vicino o In arrivo per riprovare."
          }
        }
      }
    },
