    "Neighborhood adds the nearby area. Choose Toward to also include the area ahead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neighborhood adds the nearby area. Choose Toward to also include the area ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrio añade la zona cercana. Elige Por delante para incluir también la zona hacia la que te diriges."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bairro adiciona a área próxima. Escolha Adiante para incluir também a área à frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quartier ajoute le secteur à proximité. Choisissez Devant pour inclure aussi le secteur devant vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viertel ergänzt die nahegelegene Gegend. Wählen Sie Voraus, um auch die Gegend vor Ihnen einzubeziehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quartiere aggiunge la zona nelle vicinanze. Scegli Davanti per includere anche la zona davanti a te."
          }
        }
      }
    },
