    },
    "The map server returned error %@, which usually means it is temporarily unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map server returned error %@, which usually means it is temporarily unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de mapas devolvió el error %@, que suele indicar que no está disponible temporalmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de mapas retornou o erro %@, que geralmente indica indisponibilidade temporária."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur cartographique a renvoyé l’erreur %@, ce qui indique généralement une indisponibilité temporaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kartenserver hat Fehler %@ gemeldet. Dies bedeutet meist, dass er vorübergehend nicht verfügbar ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server delle mappe ha restituito l’errore %@, che di solito indica un’indisponibilità temporanea."
          }
        }
      }
    },
    "The map server returned error %@.": {
